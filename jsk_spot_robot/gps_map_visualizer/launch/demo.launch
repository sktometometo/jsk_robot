<launch>
    <arg name="device_type" default="nmea" />

    <include file="$(find ublox_gps)/launch/ublox_device.launch">
        <arg name="param_file_name" value="$(arg device_type)" />
    </include>

    <node
        pkg="gps_map_visualizer"
        type="gps_transform_publisher.py"
        name="gps_transform_publisher"
    >
        <remap from="~nav_sat_fix" to="/ublox/fix" />

        <rosparam>
            reference_world_frame_id: yasuda
            reference_latitude: 35.713537979438996
            reference_longitude: 139.762305151285
        </rosparam>
    </node>

    <!-- 
        TF frames for hongo each elements
    -->
    <node pkg="tf2_ros" type="static_transform_publisher"
        name="$(anon yasuda)"
        args="0 0 0 0 0 0 /world /yasuda" />

    <node pkg="gps_map_visualizer"
        type="geographic_static_transform_publisher.py"
        name="$(anon tf_hongo_main_gate)">
        <rosparam>
            reference_world_frame_id: yasuda
            reference_latitude: 35.713537979438996
            reference_longitude: 139.762305151285
            target_world_frame_id: hongo_main_gate
            target_latitude: 35.712995049681204
            target_longitude: 139.75967053364684
        </rosparam>
    </node>

    <node
        pkg="gps_map_visualizer" type="geographic_static_transform_publisher.py"
        name="$(anon eng2_tfA_raw)">
        <rosparam>
            reference_world_frame_id: yasuda
            reference_latitude: 35.713537979438996
            reference_longitude: 139.762305151285
            target_world_frame_id: eng2
            target_latitude: 35.71443022192967
            target_longitude: 139.7615547854118
        </rosparam>
    </node>

    <node
        pkg="gps_map_visualizer" type="geographic_static_transform_publisher.py"
        name="$(anon eng8_tfA_raw)">
        <rosparam>
            reference_world_frame_id: yasuda
            reference_latitude: 35.713537979438996
            reference_longitude: 139.762305151285
            target_world_frame_id: eng8
            target_latitude: 35.71470007319424
            target_longitude: 139.760512685666
        </rosparam>
    </node>

    <!--
        Map image publisher
    -->
    <node
        pkg="gps_map_visualizer" type="map_image_publisher.py" name="map_image_publisher_on_eng2"
        output="screen">
        <remap from="/map" to="/eng2_map/map" />
        <remap from="/map_meta_data" to="/eng2_map/map_meta_data" />

        <rosparam>
            anchor_world_frame: yasuda
            anchor_latitude: 35.713537979438996
            anchor_longitude: 139.762305151285
            target_frame: eng2
            map_image_frame: eng2_map
        </rosparam>
    </node>

    <node
        pkg="gps_map_visualizer" type="map_image_publisher.py" name="map_image_publisher_on_eng8"
        output="screen">
        <remap from="/map" to="/eng8_map/map" />
        <remap from="/map_meta_data" to="/eng8_map/map_meta_data" />

        <rosparam>
            anchor_world_frame: yasuda
            anchor_latitude: 35.713537979438996
            anchor_longitude: 139.762305151285
            target_frame: eng8
            map_image_frame: eng8_map
        </rosparam>
    </node>

    <!-- GUI -->
    <node
        pkg="rviz" type="rviz" name="$(anon rviz)" output="log" required="true"
        args="-d $(find gps_map_visualizer)/rviz/gps_map_visualizer.rviz" />

</launch>