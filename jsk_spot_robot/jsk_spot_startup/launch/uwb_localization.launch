<launch>
    <arg name="frame_id_fixed" default="vision" />
    <arg name="debug" default="false" />

    <arg name="topicname_history" default="markers_history" unless="$(arg debug)" />
    <arg name="topicname_devices" default="markers_devices" unless="$(arg debug)" />

    <arg name="topicname_history" default="markers_history_2" if="$(arg debug)" />
    <arg name="topicname_devices" default="markers_devices_2" if="$(arg debug)" />

    <node
        pkg="uwb_localization"
        type="device_localization_node.py"
        name="device_localization_node"
        output="screen"
        >
        <remap from="markers_history" to="$(arg topicname_history)" />
        <remap from="markers_devices" to="$(arg topicname_devices)" />
        <rosparam subst_value="true">
            frame_id_fixed: $(arg frame_id_fixed)
            frame_id_uwb_tag: insta360_link
            history_timeout: 600
            thershold_num_history: 4
            threshold_hessian_eigen: 0.001
            threshold_postion_distance: 0.3
            range_distance_min: 1.0
            range_distance_max: 10.0
        </rosparam>
    </node>
</launch>
