[Unit]
Description=JSK Network Service

[Service]
Type=simple
ExecStart=/bin/bash -c ". WORKSPACE_DIR/devel/setup.bash && roscd jsk_spot_startup && echo \"USER_PASSWORD\" | sudo -S ./scripts/update_network_connection.py --wifi-profile sanshiro --lte-profile LTE --debug"
ExecStop=/bin/kill -WINCH ${MAINPID}
KillMode=control-group
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
