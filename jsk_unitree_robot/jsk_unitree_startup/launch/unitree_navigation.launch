<launch>
  <arg name="odom_frame_id" default="odom"/>
  <arg name="base_frame_id" default="base_footprint"/>
  <arg name="global_frame_id" default="map"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="odom_topic" default="/odom" />
  <arg name="laser_topic" default="/scan" />

  <!-- amcl -->
  <include file="$(find jsk_unitree_startup)/launch/includes/amcl.launch.xml">
      <arg name="scan_topic" value="$(arg laser_topic)"/> 
      <arg name="odom_frame_id" value="$(arg odom_frame_id)"/>
      <arg name="base_frame_id" value="$(arg base_frame_id)"/>
      <arg name="global_frame_id" value="$(arg global_frame_id)"/>
  </include>

  <!-- move_base -->
  <include file="$(find jsk_unitree_startup)/launch/includes/move_base.launch.xml">
      <arg name="odom_frame_id" value="$(arg odom_frame_id)"/>
      <arg name="base_frame_id" value="$(arg base_frame_id)"/>
      <arg name="global_frame_id" value="$(arg global_frame_id)"/>
      <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
      <arg name="odom_topic" value="$(arg odom_topic)" />
      <arg name="laser_topic" value="$(arg laser_topic)" />
  </include>

  <!-- Map server -->
  <include file="$(find jsk_maps)/launch/start_map_eng2.launch">
      <arg name="use_machine" value="true"/>
      <arg name="use_pictogram" value="true"/>
  </include>
</launch>
