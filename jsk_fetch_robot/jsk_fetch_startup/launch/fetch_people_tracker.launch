<launch>
  <node
      pkg="jsk_perception"
      type="rect_array_in_panorama_to_bounding_box_array.py"
      name="edgetpu_panorama_object_detection_rect_array_in_panorama_to_bounding_box_array"
      output="log"
      >
      <remap from="~panorama_image" to="/dual_fisheye_to_panorama/quater/output" />
      <remap from="~panorama_info" to="/dual_fisheye_to_panorama/panorama_info" />
      <remap from="~input_class" to="/edgetpu_panorama_object_detector/output/class" />
      <remap from="~input_rects" to="/edgetpu_panorama_object_detector/output/rects" />
      <remap from="~bbox_array" to="/edgetpu_panorama_object_detector/bbox_array" />
      <rosparam>
          frame_fixed: "map"
          dimensions_labels:
            person: [0.5, 0.5, 1.5]
            bicycle: [1.0, 1.0, 1.0]
            car: [3.0, 3.0, 3.0]
      </rosparam>
  </node>

  <!-- motpy_bbox_tracker -->
  <node pkg="jsk_perception" type="motpy_bbox_tracker_node.py" name="motpy_bbox_tracker_node" output="screen">
      <remap from="~input" to="/edgetpu_panorama_object_detection_rect_array_in_panorama_to_bounding_box_array/bbox_array" />
      <rosparam subst_value="true">
          dt: 0.2
          target_labels:
            - person
            - bicycle
            - car
          label_names: $(find jsk_perception)/config/coco_labelnames.yaml
          approximate_sync: True
          slop: 0.1
      </rosparam>
  </node>
</launch>
