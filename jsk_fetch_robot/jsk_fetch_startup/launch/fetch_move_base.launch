<launch>

  <!-- fetch or freight? -->
  <arg name="name" />
  <arg name="hostname" default="fetch1075" />

  <!-- set topics -->
  <arg name="map_topic" default="map" />
  <arg name="cmd_vel_topic" default="cmd_vel" />
  <arg name="odom_topic" default="odom" />

  <!-- move_base node -->
  <node pkg="move_base" type="move_base" name="move_base" respawn="true" output="screen">
    <rosparam file="$(find fetch_navigation)/config/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/costmap_local.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_local.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/costmap_global.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_global.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/move_base.yaml" command="load" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/move_base.yaml" command="load" />
    <rosparam command="load"
              file="$(find jsk_fetch_startup)/launch/navigation/$(arg hostname)/fetch_move_base_common_params.yaml" />
    <rosparam command="load"
              file="$(find jsk_fetch_startup)/launch/navigation/$(arg hostname)/fetch_move_base_$(env ROS_DISTRO)_params.yaml" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="map" to="$(arg map_topic)" />
  </node>

  <!-- move_base without recovery behavior -->
  <node pkg="move_base" type="move_base" name="move_base_no_recovery" respawn="true" output="screen">
    <rosparam file="$(find fetch_navigation)/config/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/costmap_local.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_local.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find fetch_navigation)/config/costmap_global.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/costmap_global.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find fetch_navigation)/config/move_base.yaml" command="load" />
    <rosparam file="$(find fetch_navigation)/config/$(arg name)/move_base.yaml" command="load" />
    <rosparam command="load"
              file="$(find jsk_fetch_startup)/launch/navigation/$(arg hostname)/fetch_move_base_common_params_without_recovery.yaml" />
    <rosparam command="load"
              file="$(find jsk_fetch_startup)/launch/navigation/$(arg hostname)/fetch_move_base_$(env ROS_DISTRO)_params.yaml" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="map" to="$(arg map_topic)" />
    <!--
    <remap from="/move_base_simple/goal" to="/move_base_no_recovery_simple/raw/goal" />
    <remap from="/move_base/goal"     to="/move_base_no_recovery/raw/goal" />
    <remap from="/move_base/result"   to="/move_base_no_recovery/raw/result" />
    <remap from="/move_base/status"   to="/move_base_no_recovery/raw/status" />
    <remap from="/move_base/cancel"   to="/move_base_no_recovery/raw/cancel" />
    <remap from="/move_base/feedback" to="/move_base_no_recovery/raw/feedback" />
    -->
    <remap from="/move_base_simple/goal" to="/move_base_no_recovery_simple/goal" />
    <remap from="/move_base/goal"     to="/move_base_no_recovery/goal" />
    <remap from="/move_base/result"   to="/move_base_no_recovery/result" />
    <remap from="/move_base/status"   to="/move_base_no_recovery/status" />
    <remap from="/move_base/cancel"   to="/move_base_no_recovery/cancel" />
    <remap from="/move_base/feedback" to="/move_base_no_recovery/feedback" />
    <remap from="/move_base/recovery_status" to="/move_base_no_recovery/recovery_status" />
  </node>

  <!--
  <node
      pkg="jsk_robot_startup"
      type="super_move_base_server.py"
      name="super_move_base_server"
      output="screen"
      >
      <remap from="~plan" to="/move_base_no_recovery/make_plan" />
      <remap from="~target_move_base/goal" to="/move_base_no_recovery/raw/goal" />
      <remap from="~target_move_base/result" to="/move_base_no_recovery/raw/result" />
      <remap from="~target_move_base/status" to="/move_base_no_recovery/raw/status" />
      <remap from="~target_move_base/cancel" to="/move_base_no_recovery/raw/cancel" />
      <remap from="~target_move_base/feedback" to="/move_base_no_recovery/raw/feedback" />
      <remap from="~move_base_simple/goal" to="/move_base_no_recovery_simple/goal" />
      <remap from="~move_base/goal" to="/move_base_no_recovery/goal" />
      <remap from="~move_base/result" to="/move_base_no_recovery/result" />
      <remap from="~move_base/status" to="/move_base_no_recovery/status" />
      <remap from="~move_base/cancel" to="/move_base_no_recovery/cancel" />
      <remap from="~move_base/feedback" to="/move_base_no_recovery/feedback" />
  </node>
  -->

</launch>
